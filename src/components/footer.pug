footer.footer
  .container
    .footer__top
      .footer__cols
        each col in footerColumns
          .footer__col
            h2.footer__title= col.title
            ul.footer__links
              each link in col.links
                li.footer__item
                  if link.href
                    a.footer__link(href=link.href)= link.text
                  else
                    span= link.text
      #newsletter.newsletter
        h2.footer__title Newsletter
        form.newsletter__form(action="#newsletter" method="get")
          p.newsletter__text Fresh case studies and design notes, once a month.
          label.visually-hidden(for="email") Your email address
          input.newsletter__input(autocomplete="email" type="email" id="email" name="email" placeholder="Your email address" required aria-describedby="email-error")
          button.btn.btn--primary.btn--block.newsletter__submit(type="submit") Subscribe
          p#email-error.newsletter__error Please enter a valid email address.
          .newsletter__agree
            input.newsletter__check(type="checkbox" id="agree" name="agree" required)
            label(for="agree") I agree to the privacy policy
        .newsletter__success(role="status")
          p.newsletter__ok
            +icon('check')
            span You’re in! Check your inbox to confirm.
          p.newsletter__note One email a month. No spam, unsubscribe anytime.
    .footer__bottom
      p.footer__copy= copyright
      +social-list()(class="footer__socials")
a.to-top(href="#top" aria-label="Back to top")
  +icon('arrow-up')
