mixin icon(name)
  case name
    when 'chevron'
      svg.icon.icon--chevron(
        width='8',
        height='13',
        viewBox='0 0 8 13',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M1 1l5.5 5.5L1 12',
          stroke='currentColor',
          stroke-width='1.2',
          fill='none'
        )
    when 'mail'
      svg.icon.icon--mail(
        width='14',
        height='10',
        viewBox='0 0 14 10',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M.5.5h13v9H.5zM.5.5 7 5.5 13.5.5',
          stroke='currentColor',
          fill='none'
        )
    when 'heart'
      svg.icon.icon--heart(
        width='16',
        height='14',
        viewBox='0 0 16 14',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M8 14 1.4 7.6A4.1 4.1 0 0 1 8 2.5a4.1 4.1 0 0 1 6.6 5.1z',
          fill='currentColor'
        )
    when 'plus'
      svg.icon.icon--plus(
        width='18',
        height='18',
        viewBox='0 0 18 18',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M9 2v14M2 9h14',
          stroke='currentColor',
          stroke-width='2',
          fill='none'
        )
    when 'arrow-up'
      svg.icon.icon--arrow-up(
        width='18',
        height='18',
        viewBox='0 0 18 18',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M9 16V3M3 8.5 9 2.5l6 6',
          stroke='currentColor',
          stroke-width='2',
          fill='none'
        )
    when 'arrow-right'
      svg.icon.icon--arrow-right(
        width='6',
        height='9',
        viewBox='0 0 6 9',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(
          d='M1 1l3.5 3.5L1 8',
          stroke='currentColor',
          stroke-width='1.5',
          fill='none'
        )
    when 'web'
      svg.icon.icon--web(
        width='48',
        height='48',
        viewBox='0 0 48 48',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        rect(x='6', y='10', width='36', height='25', fill='#7C8DA8')
        rect(x='10', y='14', width='28', height='17', fill='#8FD3C5')
        rect(x='18', y='37', width='12', height='3', fill='#7C8DA8')
    when 'motion'
      svg.icon.icon--motion(
        width='48',
        height='48',
        viewBox='0 0 48 48',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        rect(x='8', y='9', width='32', height='28', fill='#46506A')
        rect(x='12', y='13', width='24', height='20', fill='#7FC2DA')
        rect(x='18', y='39', width='12', height='3', fill='#46506A')
    when 'print'
      svg.icon.icon--print(
        width='48',
        height='48',
        viewBox='0 0 48 48',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        rect(x='10', y='26', width='28', height='14', fill='#8B93A5')
        rect(x='16', y='14', width='16', height='12', fill='#F2B63D')
    when 'illustration'
      svg.icon.icon--illustration(
        width='48',
        height='48',
        viewBox='0 0 48 48',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        path(d='M24 40 8 24a9 9 0 0 1 16-7 9 9 0 0 1 16 7z', fill='#F95858')
    when 'check'
      svg.icon.icon--check(
        width='24',
        height='24',
        viewBox='0 0 24 24',
        aria-hidden='true',
        focusable='false'
      )&attributes(attributes)
        circle(cx='12', cy='12', r='12', fill='#2CD5C4')
        path(
          d='M7 12.5l3.5 3.5L17 9',
          stroke='#fff',
          stroke-width='2',
          fill='none'
        )
    default
      - throw new Error(`Unknown icon: ${name}`);
